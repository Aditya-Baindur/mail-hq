{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["@cloudflare/workers-types", "node"],
    "paths": { "@/*": ["./*"] }
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.tsx",
    "worker/**/*.ts",
    "tests/**/*.ts",
    "worker-configuration.d.ts",
    "vite.config.ts"
  ],
  "exclude": ["node_modules", "dist", "apps"]
}
